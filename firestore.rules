rules_version = '2';

// Simple rules for this app: any signed-in user (teacher or student) can
// read/write the collections the app uses. This is what fixes the
// "Failed to join course: [cloud_firestore/permission-denied]" error —
// that error means no rules (or overly strict rules) are published for
// this project yet, so every request gets denied by default.
//
// Kept intentionally simple (no per-role checks) since this app already
// enforces who can do what in its own screens (only a teacher's own
// screens can call addCourse/endCourse/etc). If you later want stricter
// rules, the main thing to add is checking users/{uid}.role.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Anyone signed in can read profiles (needed to look up student
      // names for the roster/attendance sheet), but you can only ever
      // write your own profile doc.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /courses/{courseId} {
      // Anyone signed in can read a course (a student needs this to look
      // a course up by ID and join it).
      allow read: if request.auth != null;

      // Creating a course: must be signed in, and the teacherId being
      // written must be your own uid (so you can't create a course under
      // someone else's name).
      allow create: if request.auth != null
                    && request.resource.data.teacherId == request.auth.uid;

      // Updating a course: the teacher edits their own course (add
      // student, end course, etc), and a student updates it too when
      // joining (Join Course adds their registration number to
      // studentIds). Since students are identified by registration
      // number rather than uid here, this rule can't tightly check
      // "only your own id" — it just requires being signed in.
      allow update: if request.auth != null;

      allow delete: if false;
    }

    match /attendance/{recordId} {
      // Teachers write attendance; students read it for their own
      // "See Attendance" screen.
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
