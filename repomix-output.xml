<file path="firestore.rules">
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // users/{uid} — each user can read/write only their own profile.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // courses/{courseId} — teachers manage their own courses;
    // students can read courses they're enrolled in.
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && role() == 'teacher'
                    && resource.data.teacherId == request.auth.uid;
      allow create: if isSignedIn() && role() == 'teacher';
    }

    // attendance/{attendanceId} — only teachers can submit;
    // students can read to check their own status.
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && role() == 'teacher';
    }
  }
}
</file>

